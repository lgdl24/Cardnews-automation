{
  "name": "cardnews-automation",
  "version": "0.5.0",
  "description": "Claude Code 기반 카드뉴스 제작 자동화",
  "scripts": {
    "test": "node --test tests/check-input.test.js tests/validate.test.js tests/cli.test.js tests/spec.test.js tests/web-data.test.js tests/export.test.js tests/eval-inputs.test.js tests/job-runner.test.js tests/studio-api.test.js tests/eval-spec.test.js tests/caution.test.js",
    "test:render": "node --test tests/render.test.js tests/calibrate.test.js",
    "check": "node scripts/check-input.js",
    "validate": "node scripts/validate.js",
    "render": "node scripts/render.js",
    "log": "node scripts/log.js",
    "compare": "node scripts/compare.js",
    "new-run": "node scripts/new-run.js",
    "new-product": "node scripts/new-product.js",
    "calibrate": "node scripts/calibrate.js",
    "export": "node scripts/export.js",
    "web:install": "npm --prefix web install",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "studio": "npm --prefix web run dev"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "playwright": "^1.64.0",
    "pretendard": "^1.3.9"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
