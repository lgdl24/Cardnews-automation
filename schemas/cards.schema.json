{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lgdl24/Cardnews-automation/schemas/cards.schema.json",
  "title": "카드 구성 데이터 (cards.json)",
  "description": "형식(필드·타입·허용 값)만 정의합니다. 원문 인용 일치, 카드 수, 템플릿별 글자 수처럼 다른 파일과 비교하는 검사는 scripts/validate.js가 합니다. 규격 설명: docs/card-data-spec.md",
  "type": "object",
  "required": ["spec_version", "product_id", "stage", "sources", "analysis", "cards"],
  "additionalProperties": false,
  "properties": {
    "spec_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "product_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "stage": { "enum": ["plan", "copy", "approved"] },
    "design": {
      "description": "구성안 작업에서 고른 디자인 묶음 (#74, 선택). 입력 무드가 '자동 추천'이면 필수(validate가 검사). 묶음 이름이 목록(config/templates.json _catalog)에 있는지는 validate가 검사",
      "type": "object",
      "required": ["id", "selected_by", "reason"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "selected_by": { "enum": ["claude", "human"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "brand_mood": {
      "description": "브랜드 무드 (선택). 입력 무드가 '브랜드'(또는 무드를 비우고 브랜드 URL을 적음)면 필수(validate가 검사). 구성안 작업이 brand/ 스냅샷(없으면 제품 사진)을 보고 정함. palette는 카드 색, scene은 GPT 배경 요청에 씀 (scripts/lib/brand.js)",
      "type": "object",
      "required": ["source", "summary", "palette", "tone", "photo_style", "scene", "evidence"],
      "additionalProperties": false,
      "properties": {
        "source": { "enum": ["snapshot", "product_photo"] },
        "summary": { "type": "string", "minLength": 1 },
        "palette": {
          "type": "object",
          "required": ["bg", "surface", "text", "muted", "primary", "accent", "on-primary"],
          "additionalProperties": false,
          "properties": {
            "bg": { "$ref": "#/$defs/hexColor" },
            "surface": { "$ref": "#/$defs/hexColor" },
            "text": { "$ref": "#/$defs/hexColor" },
            "muted": { "$ref": "#/$defs/hexColor" },
            "primary": { "$ref": "#/$defs/hexColor" },
            "accent": { "$ref": "#/$defs/hexColor" },
            "on-primary": { "$ref": "#/$defs/hexColor" }
          }
        },
        "tone": { "type": "string", "minLength": 1 },
        "photo_style": { "type": "string", "minLength": 1 },
        "scene": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "section", "quote"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/sourceId" },
          "section": { "type": "string", "minLength": 1 },
          "quote": { "type": "string", "minLength": 1 }
        }
      }
    },
    "analysis": {
      "type": "object",
      "required": ["core_message", "core_evidence", "features", "usage"],
      "additionalProperties": false,
      "properties": {
        "core_message": { "type": "string", "minLength": 1 },
        "core_evidence": { "$ref": "#/$defs/evidence", "minItems": 1 },
        "features": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/analysisItem" } },
        "usage": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/analysisItem" } }
      }
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/card" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "stage": { "enum": ["copy", "approved"] } } },
      "then": { "properties": { "cards": { "items": { "required": ["copy"] } } } }
    }
  ],
  "$defs": {
    "sourceId": { "type": "string", "pattern": "^S\\d+$" },
    "hexColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/sourceId" } },
    "analysisItem": {
      "type": "object",
      "required": ["summary", "evidence"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/evidence", "minItems": 1 }
      }
    },
    "text": { "type": "string", "minLength": 1 },
    "card": {
      "type": "object",
      "required": ["no", "role", "template", "intent"],
      "additionalProperties": false,
      "properties": {
        "no": { "type": "integer", "minimum": 1 },
        "role": { "enum": ["cover", "feature", "usage", "detail", "closing"] },
        "template": { "enum": ["cover", "image", "description"] },
        "intent": { "type": "string", "minLength": 1 },
        "image": { "type": ["string", "null"], "pattern": "^[^/\\\\]+\\.(png|jpe?g|PNG|JPE?G)$" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "copy": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "role": { "enum": ["feature", "usage", "detail"] } } },
          "then": { "required": ["evidence"], "properties": { "evidence": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "template": { "const": "cover" } } },
          "then": {
            "properties": {
              "copy": {
                "type": "object",
                "required": ["title"],
                "additionalProperties": false,
                "properties": {
                  "title": { "$ref": "#/$defs/text" },
                  "subtitle": { "type": "string" },
                  "badge": { "type": "string" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "template": { "const": "image" } } },
          "then": {
            "required": ["image"],
            "properties": {
              "image": { "type": "string" },
              "copy": {
                "type": "object",
                "required": ["title"],
                "additionalProperties": false,
                "properties": {
                  "title": { "$ref": "#/$defs/text" },
                  "caption": { "type": "string" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "template": { "const": "description" } } },
          "then": {
            "properties": {
              "copy": {
                "type": "object",
                "required": ["title", "items"],
                "additionalProperties": false,
                "properties": {
                  "title": { "$ref": "#/$defs/text" },
                  "items": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/text" } }
                }
              }
            }
          }
        }
      ]
    }
  }
}
