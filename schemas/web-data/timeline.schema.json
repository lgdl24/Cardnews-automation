{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lgdl24/Cardnews-automation/schemas/web-data/timeline.schema.json",
  "title": "웹 데이터 timeline.json — 제작 과정 (V2 제작 과정)",
  "description": "docs/web-data-spec.md '3. timeline.json'. log.jsonl을 공개해도 되는 필드만 남겨 옮기고, npm run log --summary와 같은 계산으로 요약을 붙인다",
  "type": "object",
  "required": ["spec_version", "id", "summary", "jobs", "events"],
  "additionalProperties": false,
  "properties": {
    "spec_version": { "const": "0.1" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "summary": {
      "type": "object",
      "required": ["complete", "total_minutes", "ai_minutes", "human_minutes", "phases", "plan_revisions", "revision_rounds", "revised_card_ratio", "revision_types", "first_pass", "auto_fix_total"],
      "additionalProperties": false,
      "properties": {
        "complete": { "type": "boolean", "description": "final_approved가 있으면 true" },
        "total_minutes": { "type": ["number", "null"] },
        "ai_minutes": { "type": ["number", "null"] },
        "human_minutes": { "type": ["number", "null"] },
        "phases": {
          "type": "object",
          "required": ["input", "plan_job", "plan_review", "copy_job", "final_review", "revise_job"],
          "additionalProperties": false,
          "properties": {
            "input": { "type": "number" },
            "plan_job": { "type": "number" },
            "plan_review": { "type": "number" },
            "copy_job": { "type": "number" },
            "final_review": { "type": "number" },
            "revise_job": { "type": "number" }
          }
        },
        "plan_revisions": { "type": "integer", "minimum": 0 },
        "revision_rounds": { "type": "integer", "minimum": 0 },
        "revised_card_ratio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "revision_types": { "type": "object", "additionalProperties": { "type": "integer" } },
        "first_pass": { "type": ["boolean", "null"] },
        "auto_fix_total": { "type": "integer", "minimum": 0 }
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["job_id", "kind", "ok", "minutes", "error_code", "first_pass", "auto_fix_count"],
        "additionalProperties": false,
        "properties": {
          "job_id": { "type": ["string", "null"] },
          "kind": { "enum": ["plan", "copy", "revise", null] },
          "ok": { "type": ["boolean", "null"] },
          "minutes": { "type": ["number", "null"] },
          "error_code": { "type": ["string", "null"] },
          "first_pass": { "type": ["boolean", "null"] },
          "auto_fix_count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ts", "event", "job_id"],
        "additionalProperties": false,
        "properties": {
          "ts": { "$ref": "index.schema.json#/$defs/datetime" },
          "event": { "enum": ["input_submitted", "job_started", "job_finished", "validate_result", "plan_approved", "final_approved", "revision_requested"] },
          "job_id": { "type": ["string", "null"] },
          "kind": { "enum": ["plan", "copy", "revise"] },
          "ok": { "type": "boolean" },
          "error_code": { "type": ["string", "null"] },
          "check": { "enum": ["data", "layout"] },
          "error_codes": { "type": "array", "items": { "type": "string" } },
          "cards_with_errors": { "type": "array", "items": { "type": "integer" } },
          "rendered_cards": { "type": "array", "items": { "type": "integer" } },
          "stage": { "type": ["string", "null"] },
          "cards": { "type": "array", "items": { "type": "integer" } },
          "types": { "type": "array", "items": { "type": "string" } },
          "memo": { "type": "string" },
          "approved_by": { "enum": ["human", "eval"], "description": "plan_approved·final_approved만. 기록에 없으면 human" }
        }
      }
    }
  }
}
