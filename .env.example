# 서비스 모드(관리자 웹) 환경변수 예시. 복사해서 .env로 쓰고, .env는 절대 커밋하지 않습니다.
# (docker --env-file은 줄 끝 주석을 값으로 읽으므로 주석은 따로 줄에 씁니다)

# 기업이 발급한 Anthropic API 키
ANTHROPIC_API_KEY=

# 관리자 계정 (비밀번호 해시는 운영 안내의 명령으로 생성)
ADMIN_ID=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# 하루 작업 상한, 동시 작업 수
DAILY_JOB_LIMIT=20
MAX_CONCURRENT_JOBS=1

# 작업 1개당 실행 횟수 상한, 비용 상한(USD)
AGENT_MAX_TURNS=30
AGENT_MAX_BUDGET_USD=1

DATA_DIR=/data

# 시스템 Chromium을 쓸 때만
# CHROMIUM_PATH=
